{
  "name": "use-sync-typed-storage",
  "version": "1.3.0",
  "description": "Type-safe, reactive, and validated web storage wrapper for React",
  "keywords": [
    "hooks",
    "localStorage",
    "react",
    "sessionStorage",
    "sync",
    "typescript",
    "useSyncExternalStore",
    "zod"
  ],
  "license": "MIT",
  "author": "Ilia Mazan <imazan00@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihardlight/use-sync-typed-storage.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "tsc": "tsc",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/use-sync-external-store": "^1.5.0",
    "jsdom": "^29.0.2",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "react": ">=16.8",
    "react-dom": ">=16.8"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "packageManager": "pnpm@10.33.0"
}
