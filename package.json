{
    "name": "use-sync-typed-storage",
    "version": "1.2.0",
    "description": "Type-safe, reactive, and validated web storage wrapper for React",
    "author": "Ilia Mazan <imazan00@gmail.com>",
    "license": "MIT",
    "keywords": [
        "react",
        "hooks",
        "localStorage",
        "sessionStorage",
        "typescript",
        "sync",
        "useSyncExternalStore",
        "zod"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ihardlight/use-sync-typed-storage.git"
    },
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "prepublishOnly": "pnpm build",
        "tsc": "tsc",
        "test": "vitest run",
        "test:ui": "vitest --ui"
    },
    "peerDependencies": {
        "react": ">=16.8",
        "react-dom": ">=16.8",
        "use-sync-external-store": "^1.0.0"
    },
    "peerDependenciesMeta": {
        "use-sync-external-store": {
            "optional": true
        }
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.2",
        "@testing-library/react-hooks": "^8.0.1",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/use-sync-external-store": "^1.5.0",
        "jsdom": "^27.4.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "tsup": "^8.5.1",
        "typescript": "^6.0.2",
        "vitest": "^4.1.2"
    }
}
